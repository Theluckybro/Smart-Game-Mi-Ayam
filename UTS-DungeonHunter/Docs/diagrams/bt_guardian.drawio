yle="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="598" width="170" height="30" as="geometry"/></mxCell><mxCell id="l50" value="Condition" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;size=0.08;" vertex="1" parent="1"><mxGeometry x="20" y="636" width="170" height="30" as="geometry"/></mxCell><mxCell id="l51" value="Action" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="674" width="170" height="30" as="geometry"/></mxCell><mxCell id="l52" value="Skill necromancy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#2e9e4f;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="712" width="170" height="30" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Selector&lt;/b&gt;: coba child dari kiri ke kanan, berhenti di child pertama yang berhasil / masih berjalan.&lt;br&gt;&lt;b&gt;Sequence&lt;/b&gt;: semua child harus berhasil berurutan.&lt;br&gt;Semua skill bersifat &lt;i&gt;committed&lt;/i&gt;: sekali mulai, diselesaikan dulu sebelum cabang lain mengambil alih.&lt;br&gt;Minion muncul di titik NavMesh di dalam arena, langsung mengejar player (Chase); semua minion runtuh saat Guardian kalah.&lt;br&gt;Jalur node aktif tampil di AI Debug Mode (F1), contoh: &lt;i&gt;BT : Root &amp;gt; Summon &amp;gt; Bangkitkan minion [Running]&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="210" y="560" width="1000" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>