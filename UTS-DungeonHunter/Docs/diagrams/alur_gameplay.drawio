<mxfile host="drawio"><diagram name="alur_gameplay"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Alur Gameplay" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="500" height="40" as="geometry"/></mxCell><mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="95" y="70" width="110" height="54" as="geometry"/></mxCell><mxCell id="s1" value="Entrance → Great Hall&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;patroli Warrior, jebakan duri, pilar penghalang pandangan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="154" width="260" height="58" as="geometry"/></mxCell><mxCell id="s2" value="Armory (barat): tarik tuas&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;naik ramp ke balkon, dijaga Crossbowman&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="242" width="260" height="58" as="geometry"/></mxCell><mxCell id="s3" value="Gerbang Treasury terbuka&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;dynamic obstacle dimatikan → AI repath&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="260" height="58" as="geometry"/></mxCell><mxCell id="s4" value="Treasury (timur): ambil Dungeon Key&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;dijaga Skeleton Mage&lt;/span&gt;" style="rounded